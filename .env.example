# =============================================================
# PODCAST AUTOMÁTICO - PERSONAJES FAMOSOS VEGETARIANOS DEL MUNDO
# =============================================================

# --- Claude API (Anthropic) ---
# Único servicio de pago (~$0.003 por episodio con Haiku)
ANTHROPIC_API_KEY=tu_clave_anthropic_aqui

# --- TTS: edge-tts (GRATUITO - Microsoft Neural Voices) ---
# No requiere API key. Voces neurales de alta calidad.
# Opciones de voz en español (todas gratuitas):
#   es-ES-AlvaroNeural   → Álvaro, España, masculino  ⭐ recomendado
#   es-ES-ElviraNeural   → Elvira, España, femenino
#   es-MX-JorgeNeural    → Jorge, México, masculino
#   es-MX-DaliaNeural    → Dalia, México, femenino
#   es-AR-TomasNeural    → Tomás, Argentina, masculino
#   es-CO-GonzaloNeural  → Gonzalo, Colombia, masculino
TTS_VOICE=es-ES-AlvaroNeural
TTS_RATE=-5%     # Velocidad: -10% más lento, +10% más rápido
TTS_VOLUME=+10%  # Volumen: +10% más alto

# --- YouTube Data API v3 ---
# Descarga el archivo client_secret.json desde Google Cloud Console
# y colócalo en la carpeta credentials/
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json
# ID de la categoría de YouTube (22 = Personas y blogs, 27 = Educación)
YOUTUBE_CATEGORY_ID=22
# Privacidad del video: public, unlisted, private
YOUTUBE_PRIVACY=public

# --- Configuración del Podcast ---
PODCAST_NAME=Personajes Famosos Vegetarianos del Mundo
PODCAST_HOST=Alejandro
# Hora de publicación diaria (formato 24h, hora local del servidor)
SCHEDULE_HOUR=23
SCHEDULE_MINUTE=20

# --- Configuración del Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
